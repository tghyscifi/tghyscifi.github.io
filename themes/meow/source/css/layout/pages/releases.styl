/*
 * hexo theme meow
 * releases page styles
 */

.releases-info
  margin: 1.5rem 0
  > * + *
    margin-top: 1.1rem

.releases-loading,
.releases-error
  text-align: center
  padding: 3rem 1rem
  color: var(--font-color-light-1)

.releases-error
  p
    margin-bottom: 1rem

.releases-card
  border: 1px solid var(--card-border-color)
  border-radius: 12px
  background: var(--background-color)
  box-shadow: var(--meow-card-shadow)
  padding: 1.4rem 1.8rem

.releases-card-head
  border-bottom: 1px dashed var(--card-border-color)
  padding-bottom: 1rem
  margin-bottom: 1.2rem

.releases-tag-row
  display: flex
  align-items: center
  gap: .6rem
  margin-bottom: .5rem

.releases-badge
  display: inline-block
  font-size: .75rem
  line-height: 1.6
  padding: 1px 12px
  border-radius: 999px
  color: var(--font-color-invert)
  background: var(--theme-color)

.releases-tag
  font-family: var(--meow-font-code)
  font-size: 1.5rem
  font-weight: 600

.releases-title
  font-size: 1.15rem
  margin: .3rem 0 .2rem

.releases-meta
  font-size: .85rem

.releases-date
  color: var(--font-color-light-1)

.releases-body
  font-size: .95rem
  line-height: 1.7
  white-space: pre-wrap
  word-break: break-word
  padding: .4rem 0 .2rem

.releases-assets
  display: flex
  flex-direction: column
  gap: .6rem
  margin-top: .5rem

.releases-asset
  display: flex
  justify-content: space-between
  align-items: center
  gap: 1rem
  padding: .7rem 1rem
  border: 1px solid var(--card-border-color)
  border-radius: 8px
  color: var(--font-color)
  background: var(--background-color-grey-transparent-2)
  transition: border-color .2s, color .2s
  &:hover
    border-color: var(--theme-color)
    color: var(--theme-color)

.releases-asset-name
  word-break: break-all

.releases-asset-meta
  flex-shrink: 0
  font-size: .82rem
  color: var(--font-color-light-1)

.releases-foot
  display: flex
  flex-wrap: wrap
  gap: .8rem
  margin-top: 1.2rem

.releases-btn
  display: inline-block
  padding: .5rem 1.2rem
  border-radius: 6px
  border: 1px solid var(--theme-color)
  background: var(--theme-color)
  color: var(--font-color-invert)
  transition: opacity .2s
  &:hover
    opacity: .85

.releases-btn-ghost
  background: transparent
  color: var(--theme-color)
  &:hover
    opacity: 1
    background: var(--theme-color)
    color: var(--font-color-invert)

+meow-smallscreen()
  .releases-asset
    flex-direction: column
    align-items: flex-start
    gap: .3rem