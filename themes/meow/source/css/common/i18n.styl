.language-switch
  display inline-flex
  align-items center
  justify-content center
  padding .3rem .6rem
  margin .25rem .5rem
  border 1px solid currentColor
  border-radius .4rem
  color inherit
  font-size .85rem
  line-height 1.4
  white-space nowrap

.language-switch:focus-visible
  outline 2px solid currentColor
  outline-offset 3px

.ui-language-note
  width calc(100% - 2rem)
  max-width 75rem
  margin 1rem auto
  padding .75rem 1rem
  border 1px solid currentColor
  border-radius .5rem
  font-size .9rem

html[lang='en'] .home-article-title
  overflow-wrap anywhere
