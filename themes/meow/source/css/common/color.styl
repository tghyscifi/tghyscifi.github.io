// LIGHT MODE COLOR
$theme-color = convert(hexo-config('color.light.theme_color'))
$theme-color-light-1 = #6f7584
$theme-color-light-2 = #3a3f4d
$theme-color-light-3 = #4a5060
$theme-color-transparent-1 = alpha($theme-color, .6)
$theme-color-dark-1 = darken($theme-color, 10%)
$background-color = #fff
$background-color-transparent-1 = alpha($background-color, .85)
$background-color-transparent-2 = alpha($background-color, .7)
$background-color-transparent-3 = alpha($background-color, .4)
$background-color-grey = #e7e9ee
$background-color-grey-light-1 = lighten($background-color-grey, 40%)
$background-color-grey-light-2 = lighten($background-color-grey, 55%)
$background-color-grey-transparent = alpha($background-color-grey, .25)
$background-color-grey-transparent-2 = alpha($background-color-grey, .15)
$background-color-body = #f6f7f9
$background-color-page = $background-color-transparent-1
$font-color = #2e3136
$font-color-light-1 = lighten($font-color, 30%)
$font-color-light-2 = lighten($font-color, 50%)
$font-color-light-3 = lighten($font-color, 75%)
$font-color-navbar = lighten($font-color, 10%)
$font-color-dark-1 = darken($font-color, 10%)
$font-color-dark-2 = darken($font-color, 30%)
$font-color-invert = #fff
$link-hover-font-color = #fff
$nav-background-color = #ffffff
$card-border-color = #d9dce2

// DARK MODE COLOR
$dark-theme-color = convert(hexo-config('color.dark.theme_color'))
$dark-theme-color-light-1 = lighten($dark-theme-color, 40%)
$dark-theme-color-light-2 = lighten($dark-theme-color, 20%)
$dark-theme-color-light-3 = lighten($dark-theme-color, 30%)
$dark-theme-color-transparent-1 = alpha($dark-theme-color, .6)
$dark-theme-color-dark-1 = darken($dark-theme-color, 10%)
$dark-background-color = #232733
$dark-background-color-transparent-1 = alpha($dark-background-color, .88)
$dark-background-color-transparent-2 = alpha($dark-background-color, .7)
$dark-background-color-transparent-3 = alpha($dark-background-color, .4)
$dark-background-color-grey = #353c4b
$dark-background-color-grey-light-1 = darken($dark-background-color-grey, 10%)
$dark-background-color-grey-light-2 = darken($dark-background-color-grey, 20%)
$dark-background-color-grey-transparent = alpha($dark-background-color-grey, .25)
$dark-background-color-grey-transparent-2 = alpha($dark-background-color-grey, .35)
$dark-background-color-body = #191c26
$dark-background-color-page = $dark-background-color-transparent-2
$dark-font-color = #c6cbd7
$dark-font-color-light-1 = darken($dark-font-color, 20%)
$dark-font-color-light-2 = darken($dark-font-color, 30%)
$dark-font-color-light-3 = darken($dark-font-color, 50%)
$dark-font-color-dark-1 = darken($dark-font-color, 10%)
$dark-font-color-dark-2 = darken($dark-font-color, 30%)
$dark-font-color-invert = #f2f4fa
$dark-link-hover-font-color = #1b1f2a
$dark-nav-background-color = #232733
$dark-card-border-color = #2d3340

// Meow Color
$color-pink = #FF7CA1
$color-pink-light = lighten($color-pink, 80%)
$color-pink-light-2 = lighten($color-pink, 25%)
$color-purple = #c2a0ff
$color-purple-light = lighten($color-purple, 80%)
$color-purple-light-2 = lighten($color-purple, 40%)
$color-yellow = #ffdf6a
$color-yellow-light = lighten($color-yellow, 80%)
$color-yellow-light-2 = lighten($color-yellow, 30%)
$color-blue = #7fbfff
$color-blue-light = lighten($color-blue, 80%)
$color-blue-light-2 = lighten($color-blue, 30%)
$color-green = #7ed86e
$color-green-light = lighten($color-green, 80%)
$color-green-light-2 = lighten($color-green, 30%)